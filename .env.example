# PostgreSQL configuration
POSTGRES_USER=busreserve
POSTGRES_PASSWORD=busreserve_dev_change_me
POSTGRES_DB=busreserve

# Backend application configuration
FLASK_ENV=production
SECRET_KEY=replace-with-strong-random-secret-32b
JWT_SECRET_KEY=replace-with-strong-jwt-secret-32b
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480
COOKIE_SECURE=false
ALLOW_LOCAL_MAIL_PREVIEW=true
RATELIMIT_ENABLED=true
LOG_LEVEL=INFO
SEED_ON_STARTUP=true
SEED_DEMO_USER_PASSWORD=ChangeThisToYourSecureUserPassword123!
SEED_DEMO_ADMIN_PASSWORD=ChangeThisToYourSecureAdminPassword123!
APP_TIMEZONE=Asia/Kolkata
BOOKING_HORIZON_DAYS=90
CORS_ORIGINS=http://localhost:8080,http://localhost
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Optional SMTP delivery (leave empty for local sandbox outbox mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@busreserve.local
SMTP_USE_TLS=true

# Container images and reverse proxy port
BACKEND_IMAGE=busreserve-backend:local
FRONTEND_IMAGE=busreserve-frontend:local
NGINX_PORT=8080

# Phase 4: Google Gemini AI (free-tier-first; keep empty to force deterministic local fallback)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional configurable alternative when primary hits quota/overload (e.g. gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODEL=
GEMINI_ENABLED=true
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_DAILY_REQUEST_LIMIT=200
AI_USER_DAILY_LIMIT=50
AI_MAX_INPUT_LENGTH=1000
AI_MAX_OUTPUT_TOKENS=600
AI_HISTORY_LIMIT=20
AI_RECOVERY_COOLDOWN_SECONDS=60
