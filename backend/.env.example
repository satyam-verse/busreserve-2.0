FLASK_ENV=development
SECRET_KEY=dev-only-change-in-production
JWT_SECRET_KEY=dev-jwt-only-change-in-production
ALLOW_LOCAL_MAIL_PREVIEW=true
RATELIMIT_ENABLED=true
DATABASE_URL=postgresql+psycopg2://busreserve:busreserve_dev@localhost:5432/busreserve
TEST_DATABASE_URL=postgresql+psycopg2://busreserve:busreserve_dev@localhost:5432/busreserve_test
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
BOOKING_HORIZON_DAYS=90
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# Phase 4: Google Gemini AI (backend-only; placeholder only)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional configurable alternative when primary hits quota/overload (e.g. gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODEL=
GEMINI_ENABLED=true
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_DAILY_REQUEST_LIMIT=200
AI_USER_DAILY_LIMIT=50
AI_MAX_INPUT_LENGTH=1000
AI_MAX_OUTPUT_TOKENS=600
AI_HISTORY_LIMIT=20
AI_RECOVERY_COOLDOWN_SECONDS=60
