{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Overview & Traffic Ingress",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Rate (RPS by Endpoint)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(busreserve_http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 2 }] } } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "HTTP Error Rate (% 4xx / 5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(busreserve_http_requests_total{status_code=~\"5..\"}[1m])) / sum(rate(busreserve_http_requests_total[1m])) * 100",
          "legendFormat": "5xx Server Errors"
        },
        {
          "expr": "sum(rate(busreserve_http_requests_total{status_code=~\"4..\"}[1m])) / sum(rate(busreserve_http_requests_total[1m])) * 100",
          "legendFormat": "4xx Client Errors"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Request Latency Quantiles (P50, P95, P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(busreserve_http_request_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(busreserve_http_request_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(busreserve_http_request_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Database Connection Pool Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "title": "SQLAlchemy Pool Connections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "busreserve_db_connections{metric=\"checked_out\"}",
          "legendFormat": "Checked Out (Active)"
        },
        {
          "expr": "busreserve_db_connections{metric=\"checked_in\"}",
          "legendFormat": "Checked In (Idle)"
        },
        {
          "expr": "busreserve_db_connections{metric=\"size\"}",
          "legendFormat": "Pool Capacity"
        },
        {
          "expr": "busreserve_db_connections{metric=\"overflow\"}",
          "legendFormat": "Pool Overflow"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "title": "Process Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "busreserve_app_uptime_seconds",
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Business Transactions, Bookings & Payments",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "id": 6,
      "title": "Seat Reservations Total",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(busreserve_bookings_created_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 16 },
      "id": 7,
      "title": "Payment Settlement Status Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(busreserve_payment_transactions_total[5m])) by (status, gateway)",
          "legendFormat": "{{gateway}} - {{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyINR" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 16 },
      "id": 8,
      "title": "Total Settled Revenue (INR)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(busreserve_payment_amount_inr_total)",
          "legendFormat": "Gross Settled INR"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["busreserve", "production", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "BusReserve 2.0 Production Overview",
  "uid": "busreserve-prod-overview",
  "version": 1
}
