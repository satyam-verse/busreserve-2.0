{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BackupArchiveOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::busreserve-backups-*",
        "arn:aws:s3:::busreserve-backups-*/*"
      ]
    },
    {
      "Sid": "AllowCloudWatchContainerLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/busreserve/*"
    },
    {
      "Sid": "AllowEcrImagePullOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    }
  ]
}
