{
  "family": "busreserve-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::123456789012:role/BusReserveEcsExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/BusReserveBackendTaskRole",
  "containerDefinitions": [
    {
      "name": "busreserve-backend",
      "image": "ghcr.io/your-org/busreserve-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "FLASK_ENV", "value": "production" },
        { "name": "APP_TIMEZONE", "value": "Asia/Kolkata" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "BOOKING_HORIZON_DAYS", "value": "90" },
        { "name": "GUNICORN_WORKERS", "value": "4" },
        { "name": "GUNICORN_THREADS", "value": "4" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "RATELIMIT_ENABLED", "value": "true" },
        { "name": "ALLOW_LOCAL_MAIL_PREVIEW", "value": "false" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:busreserve/prod/database-url"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:busreserve/prod/app-secrets:SECRET_KEY::"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:busreserve/prod/app-secrets:JWT_SECRET_KEY::"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:busreserve/prod/app-secrets:GEMINI_API_KEY::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health/ready', timeout=3)\" || exit 1"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/busreserve-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
